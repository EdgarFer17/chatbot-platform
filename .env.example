APP_NAME=Chatbot Platform
APP_ENV=development
APP_VERSION=1.0.0-rc.1
LOG_LEVEL=INFO

# Nunca reutilize segredos da Infolight neste produto.
DATABASE_URL=postgresql+psycopg://chatbot:change-me@database:5432/chatbot_platform
JWT_SECRET_KEY=change-me-with-at-least-32-random-characters
ADMIN_MASTER_KEY=change-me-with-an-independent-admin-secret
ADMIN_SESSION_SECRET=gere-um-segredo-aleatorio-longo
ADMIN_COOKIE_SECURE=false

# Provedor de geraÃ§Ã£o. A chave real deve existir apenas no .env local/servidor.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_SECONDS=35
LLM_REASONING_EFFORT=low

# Origens separadas por vÃ­rgula. Em produÃ§Ã£o, nÃ£o utilize curingas.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:4173
CONVERSATION_CONTEXT_MESSAGES=6
CONVERSATION_CONTEXT_CHARACTERS=8000

# Endereços públicos usados no código de instalação do widget.
PLATFORM_PUBLIC_API_URL=http://localhost:8010
WIDGET_PUBLIC_URL=http://localhost:3005
ADMIN_PASSWORD_HASH=
