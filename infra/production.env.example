# Substitua pelos domínios reais, sem https nestes dois campos.
PANEL_DOMAIN=painel.exemplo.edu.br
API_DOMAIN=api-chat.exemplo.edu.br
PLATFORM_PUBLIC_API_URL=https://api-chat.exemplo.edu.br
WIDGET_PUBLIC_URL=https://painel.exemplo.edu.br
ALLOWED_ORIGINS=https://www.exemplo.edu.br,https://exemplo.edu.br,https://painel.exemplo.edu.br
